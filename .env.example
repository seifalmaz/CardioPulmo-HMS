# ==============================================================================
# CardioPulmo-HMS - Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# NEVER commit real passwords, secret keys, or private tokens to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Configuration
# ------------------------------------------------------------------------------
APP_NAME=CardioPulmo-HMS
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cardiopulmo_db
DB_USER=cardiopulmo_user
DB_PASSWORD=change_this_to_a_secure_password
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Session Tokens (Argon2id + JWT)
# ------------------------------------------------------------------------------
# Generate a secure 32-byte hexadecimal key: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing configuration (Argon2id)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1

# ------------------------------------------------------------------------------
# 4. Storage & Dataset Paths (Local / MinIO / S3)
# ------------------------------------------------------------------------------
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SYNTHETIC_DIR=./data/synthetic
STORAGE_BUCKET_CXR=./data/storage/cxr_radiographs
SIGNED_URL_EXPIRY_SECONDS=300

# ------------------------------------------------------------------------------
# 5. Machine Learning & Computer Vision Services
# ------------------------------------------------------------------------------
TORCH_DEVICE=cuda
MODEL_CV_WEIGHTS_PATH=./ml/models/densenet121_chexnet_nih14.pth
MODEL_TABULAR_PATH=./ml/models/xgboost_heart_risk.joblib
GRADCAM_TARGET_LAYER=features.denseblock4.denselayer16.conv2
CONFIDENCE_THRESHOLD_CXR=0.50

# ------------------------------------------------------------------------------
# 6. AI Agent Handoff & Prompt-Injection Guardrails
# ------------------------------------------------------------------------------
HANDOFF_SCHEMA_VERSION=1.0.0
HANDOFF_AUDIT_ENABLED=true
HANDOFF_STRICT_DELIMITERS=true
HANDOFF_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 7. Patient RAG & Knowledge Graph (Optional / Future Milestones)
# ------------------------------------------------------------------------------
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_VECTOR_DB=chroma
RAG_KNOWLEDGE_GRAPH_BACKEND=networkx
RAG_RETRIEVAL_TOP_K=4
LLM_API_KEY=your_api_key_here
